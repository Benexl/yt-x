_install_dep_rofi() {
  _install "rofi"
}

_install_dep_ffmpegthumbnailer() {
  _install "ffmpegthumbnailer"
}

_install_deps() {
  while IFS= read -r dep; do
    case "$dep" in
    fzf)
      _install_dep_fzf
      ;;
    gum)
      _install_dep_gum
      ;;
    chafa)
      _install_dep_chafa
      ;;
    yt-dlp)
      _install_dep_yt_dlp
      ;;
    mpv)
      _install_dep_mpv
      ;;
    vlc)
      _install_dep_vlc
      ;;
    tplay)
      _install_dep_tplay
      ;;
    rofi)
      _install_dep_rofi
      ;;
    ffmpegthumbnailer)
      _install_dep_ffmpegthumbnailer
      ;;
    *) ;;
    esac
  done
